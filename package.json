{
  "name": "blackjack-online",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test src/features/blackjack/lib/*.test.ts",
    "test:ui": "tsx --test src/tests/*.test.tsx"
  },
  "dependencies": {
    "next": "^16.4.5",
    "peerjs": "^1.5.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "postcss": "^8.5.10",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
